# Secrets
.env

# Personal application facts (CTC, notice period, contact) — keep private.
# candidate.example.json IS committed as the schema template.
candidate.json

# Store + runtime data (the schema is in data/schema.sql; the DB is generated)
data/jobs.db
data/jobs.db-*
data/jobs.json
data/jobs.public.json
data/apify_keys.json
data/grok_keys.json

# Scratch / intermediate (screenshots, downloads, browser profile)
.tmp/

# Per-job tailored résumé variants (generated copies; master .tex/PDF are tracked)
tailored/

# Per-application artifact store (generated by `main.py report`)
applications/

# Tailored résumé build artefacts
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Python
__pycache__/
*.pyc
.venv/
venv/

# graphify output is regenerated
graphify-out/

# Frontend (web/) — installed deps + build output, both regenerated.
# web/public/jobs.public.json is NOT ignored — it's the committed "published
# snapshot" the deploy workflow builds from (refreshed by the scheduled scrape
# workflow's commit, or manually via `npm run build:static` + a normal commit).
web/node_modules/
web/dist/
web/dist-static/

# Screenshot-test artifacts
test/
