# Copy to `.env` and fill in. NEVER commit `.env`.

# ── Apify (managed scraping for LinkedIn / Naukri / Indeed) ──────────────
# Get a token at https://console.apify.com/account/integrations
# MULTIPLE keys supported (FREE plan = ~$5 credit/key/month): the scraper rotates
# through them by health and skips exhausted/invalid ones automatically.
#   - put several in APIFY_TOKEN separated by comma/space, AND/OR
#   - use numbered vars APIFY_TOKEN_1, APIFY_TOKEN_2, …
# Check health any time:  scrape.py --keys   (reset with --reset-keys all)
APIFY_TOKEN=
# APIFY_TOKEN_1=
# APIFY_TOKEN_2=

# Optional: override the default actor ids per portal (verified 2026-06-30).
# APIFY_ACTOR_LINKEDIN=curious_coder/linkedin-jobs-scraper   # ~$0.001/result
# APIFY_ACTOR_NAUKRI=muhammetakkurtt/naukri-job-scraper      # min 50 jobs/run
# APIFY_ACTOR_INDEED=borderline/indeed-scraper               # ~$0.005/job
# APIFY_INDEED_COUNTRY=in        # Indeed market (default: in)
# APIFY_NAUKRI_DETAILS=0         # 1=fetch full JD text (default), 0=cheaper standard
# APIFY_MAX_CHARGE_USD=0.50      # hard per-run spend ceiling (safety net)

# ── Job portals (company career sites via ATS public JSON — free, no token) ──
# One plugin per ATS platform (greenhouse.py/lever.py/ashby.py); each is only
# "available" once its *_COMPANIES var below names at least one company.
# Format: comma-separated slugs, each `slug` or `slug:Display Name` (the
# display-name override matters for Lever/Ashby, whose APIs expose no company
# name at all). Multiple companies are scraped fairly (round-robin), not in
# first-listed-company-first order. See docs/job_portals.md for verified
# endpoints + how to find a company's slug.
# GREENHOUSE_COMPANIES=huntress,wizinc:Wiz,gitlab
# LEVER_COMPANIES=certik:CertiK
# ASHBY_COMPANIES=vanta:Vanta,chainalysis-careers:Chainalysis

# Same idea, five more ATS platforms (added 2026-07-05). Same slug / slug:Display
# Name format as above — see docs/job_portals.md for verified endpoints per platform.
# SMARTRECRUITERS_COMPANIES=Visa,MattelInc:Mattel
# RECRUITEE_COMPANIES=aikidosecurity:Aikido Security
# BAMBOOHR_COMPANIES=
# WORKABLE_COMPANIES=dispel:Dispel
#
# Workday is the exception: no single slug exists, so each entry needs THREE
# parts — tenant:wdN:site (wdN is the numbered CxS shard 1-5, found by trial or
# by reading the careers-page network request; site is a per-tenant path segment).
# Optional 4th field overrides the display name.
# WORKDAY_COMPANIES=workday:5:Workday:Workday,cisco:1:External:Cisco
#
# Zoho Recruit (added 2026-07-06) — an org is addressed by subdomain.tld
# (TLD varies per org: .com and .in both seen live), NOT a bare slug. Public,
# unauthenticated endpoint — no OAuth token needed despite Zoho's main API
# requiring one. See zoho_recruit.py docstring for the discovery details.
# ZOHORECRUIT_COMPANIES=simbian.in:Simbian,instasafe.com:InstaSafe

# ── Custom (non-ATS) career-site plugins ────────────────────────────────
# One thin plugin per bespoke company site (unlike ATS plugins, these can't
# share a `.env` company list since each site has its own markup/URL shape).
# `synopsys.py` needs `playwright install chromium` run once (see
# requirements.txt) — no other config; its `is_available()` checks chromium
# is actually installed, not any env var here.

# ── LLM (jd-understander, humanise-responder, apply-agent reasoning) ─────
# How LLM reasoning runs (set via --llm flag; this var is the fallback default):
#   session  = use THIS Claude Code session (the orchestrator) — no API key, free.
#   api      = call the Anthropic API with ANTHROPIC_API_KEY below.
#   grok     = call the xAI / Groq API with XAI_API_KEY below.
#   deepseek = call DeepSeek's API with DEEPSEEK_API_KEY below.
#   nvidia   = call NVIDIA NIM with NVIDIA_API_KEY below (100+ open-weight models, ~40 req/min free).
LLM_PROVIDER=session
# LLM_MODEL overrides the per-provider default model.
# LLM_MODEL=moonshotai/kimi-k2.6
# LLM_SYSTEM_PREFIX is prepended to every system prompt (NVIDIA path sets this automatically
# to "detailed thinking off" to prevent Nemotron reasoning-mode from burning the token budget).
# LLM_SYSTEM_PREFIX=

# api mode (Anthropic):
ANTHROPIC_API_KEY=

# grok mode (xAI OR Groq — OpenAI-compatible) — get a key at https://console.x.ai
# (or a free gsk_ key at https://console.groq.com; Groq's free tier is TPM-rate-limited).
# MULTI-KEY: put several keys here (comma/space separated) and/or as XAI_API_KEY_1,
# XAI_API_KEY_2, … — they auto-rotate on a 429 (a fresh key = a fresh TPM bucket).
# See health with `main.py keys --llm`. GROK_API_KEY is accepted as an alias.
XAI_API_KEY=
# XAI_API_KEY_1=
# XAI_API_KEY_2=
# XAI_BASE_URL=https://api.x.ai/v1   # override only for a proxy/gateway

# deepseek mode (`--llm deepseek`) — OpenAI-compatible, paid but very cheap and NOT
# TPM-rate-limited like Groq's free tier. Key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # override only for a proxy/gateway

# nvidia mode (`--llm nvidia`) — NVIDIA NIM, OpenAI-compatible, 100+ open-weight models.
# Free tier: ~40 req/min. Get an nvapi-… key at https://build.nvidia.com (API Key section).
# Models benchmarked 2026-07-04 on our real ranking + JD-understand prompts:
#   Primary moonshotai/kimi-k2.6 — best seniority-rule calibration, 1.6/4.7 s, bare JSON.
#   Backup  mistralai/mistral-large-3-675b-instruct-2512 — fastest (1.3/2.8 s), fenced JSON.
# The NVIDIA path automatically sets LLM_SYSTEM_PREFIX="detailed thinking off" to disable
# Nemotron reasoning-mode (prevents <think> from eating the token budget). Harmless for
# non-reasoning models like Kimi/Mistral.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1           # override only for a gateway
# LLM_MODEL=moonshotai/kimi-k2.6                                # override primary model
# LLM_BACKUP_MODEL=mistralai/mistral-large-3-675b-instruct-2512 # override backup model

# ── Browser session for custom scrapers + apply-agent ───────────────────
# Path to a persistent Playwright user-data dir holding YOUR logged-in
# portal sessions (so no passwords are stored by this app).
PLAYWRIGHT_USER_DATA_DIR=.tmp/pw-profile

# ── Store ───────────────────────────────────────────────────────────────
JOBS_DB_PATH=data/jobs.db
