# Copy to `.env` and fill in. NEVER commit `.env`.

# ── Apify (managed scraping for LinkedIn / Naukri / Indeed) ──────────────
# Get a token at https://console.apify.com/account/integrations
# MULTIPLE keys supported (FREE plan = ~$5 credit/key/month): the scraper rotates
# through them by health and skips exhausted/invalid ones automatically.
#   - put several in APIFY_TOKEN separated by comma/space, AND/OR
#   - use numbered vars APIFY_TOKEN_1, APIFY_TOKEN_2, …
# Check health any time:  scrape.py --keys   (reset with --reset-keys all)
APIFY_TOKEN=
# APIFY_TOKEN_1=
# APIFY_TOKEN_2=

# Optional: override the default actor ids per portal (verified 2026-06-30).
# APIFY_ACTOR_LINKEDIN=curious_coder/linkedin-jobs-scraper   # ~$0.001/result
# APIFY_ACTOR_NAUKRI=muhammetakkurtt/naukri-job-scraper      # min 50 jobs/run
# APIFY_ACTOR_INDEED=borderline/indeed-scraper               # ~$0.005/job
# APIFY_INDEED_COUNTRY=in        # Indeed market (default: in)
# APIFY_NAUKRI_DETAILS=0         # 1=fetch full JD text (default), 0=cheaper standard
# APIFY_MAX_CHARGE_USD=0.50      # hard per-run spend ceiling (safety net)

# ── LLM (jd-understander, humanise-responder, apply-agent reasoning) ─────
# How LLM reasoning runs:
#   session = use THIS Claude Code session (the orchestrator) — no API key, free.
#   api     = call the Anthropic API with ANTHROPIC_API_KEY below.
#   grok    = call the xAI (Grok) API with XAI_API_KEY below.
LLM_PROVIDER=session
# LLM_MODEL overrides the per-provider default (api=claude-sonnet-4-6, grok=grok-4).
# LLM_MODEL=claude-sonnet-4-6

# api mode (Anthropic):
ANTHROPIC_API_KEY=

# grok mode (xAI OR Groq — OpenAI-compatible) — get a key at https://console.x.ai
# (or a free gsk_ key at https://console.groq.com; Groq's free tier is TPM-rate-limited).
# MULTI-KEY: put several keys here (comma/space separated) and/or as XAI_API_KEY_1,
# XAI_API_KEY_2, … — they auto-rotate on a 429 (a fresh key = a fresh TPM bucket).
# See health with `main.py keys --llm`. GROK_API_KEY is accepted as an alias.
XAI_API_KEY=
# XAI_API_KEY_1=
# XAI_API_KEY_2=
# XAI_BASE_URL=https://api.x.ai/v1   # override only for a proxy/gateway

# deepseek mode (`--llm deepseek`) — OpenAI-compatible, paid but very cheap and NOT
# TPM-rate-limited like Groq's free tier. Key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # override only for a proxy/gateway

# ── Browser session for custom scrapers + apply-agent ───────────────────
# Path to a persistent Playwright user-data dir holding YOUR logged-in
# portal sessions (so no passwords are stored by this app).
PLAYWRIGHT_USER_DATA_DIR=.tmp/pw-profile

# ── Store ───────────────────────────────────────────────────────────────
JOBS_DB_PATH=data/jobs.db
